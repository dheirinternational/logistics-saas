# ── Database ──────────────────────────────────────────────────────────
# Production: use the Transaction pooler URI (port 6543) from Supabase.
DATABASE_URL=postgresql://postgres.XXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Local / staging (session pooler port 5432 is fine here):
TEST_DATABASE_URL=postgresql://postgres.XXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Sessions ─────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=session

# ── Supabase (Storage only — auth is custom) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://XXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_URL_TEST=https://XXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY_TEST=eyJ...

# ── App URL (required for correct link previews & SEO canonical URLs) ──
NEXT_PUBLIC_APP_URL=https://www.dheirinternational.com
BASE_URL=https://www.dheirinternational.com

# ── Cloudinary (legacy — optional) ───────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Paystack ─────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# ── Monnify ──────────────────────────────────────────────────────────
MONNIFY_API_KEY=MK_TEST_...
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CHECKOUT_ENABLED=false
NEXT_PUBLIC_MONNIFY_CHECKOUT_ENABLED=false

# ── Resend (email) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Bank Transfer ────────────────────────────────────────────────────
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
